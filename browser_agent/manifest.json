{
  "manifest_version": 3,
  "name": "AntiGravity Agent",
  "version": "2.0",
  "description": "Zero-Trust Real-Time Phishing and Web Threat Defense Agent.",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "http://127.0.0.1:8001/*",
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AntiGravity Security Agent"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
