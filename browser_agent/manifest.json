{
  "manifest_version": 3,
  "name": "AntiGravity Agent",
  "version": "2.1",
  "description": "Zero-Trust Real-Time Phishing, Visual Impersonation & Web Threat Defense Agent.",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "notifications",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8001/*",
    "<all_urls>"
  ],
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_title": "AntiGravity Security Agent",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
